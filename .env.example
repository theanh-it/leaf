
PORT=5000
NODE_ENV=development
JWT_SECRET=
DATABASE_URL="postgresql://postgres:password@localhost:5432/leaf"
PG_DUMP_PATH=/Applications/Postgres.app/Contents/Versions/latest/bin/pg_dump
CORS_ORIGIN=*
BASE_URL=http://localhost:5000

# So ngay giu backup va so file moi nhat toi thieu giu lai cho moi loai (> 0)
BACKUP_RETENTION_DAYS=7

# Optional: mac dinh dung pg_restore cung thu muc voi PG_DUMP_PATH, hoac PATH
# PG_RESTORE_PATH=/Applications/Postgres.app/Contents/Versions/latest/bin/pg_restore
# Gioi han tung file upload (10 GiB) va files sau giai nen (50 GiB)
# BACKUP_RESTORE_MAX_FILE_SIZE=10737418240
# BACKUP_RESTORE_MAX_EXTRACTED_SIZE=53687091200

SITE_NAME=Leaf App
DEFAULT_OG_IMAGE=/og-default.jpg
SITE_LOCALE=vi_VN
TWITTER_HANDLE=

VITE_PORT=3000
VITE_API_URL=http://localhost:5000/api
