# ============================================
# Dependencies
# ============================================
node_modules/
.pnp/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Other package managers' lockfiles (this project uses Bun)
package-lock.json
yarn.lock
pnpm-lock.yaml

# ============================================
# Bun
# ============================================
.bun/
bun-debug-*.log

# ============================================
# Build outputs
# ============================================
dist/
build/
out/
.output/
.cache/
.parcel-cache/
.vite/
dist-ssr/

# ============================================
# TypeScript
# ============================================
*.tsbuildinfo
tsconfig.tsbuildinfo

# ============================================
# Prisma
# ============================================
# Generated Prisma client (defined in schema as ../node_modules/.prisma/client)
# Already covered by node_modules/, but keep explicit:
prisma/.env
prisma/migrations/dev.db*

# ============================================
# Environment files (NEVER commit secrets)
# ============================================
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
# Keep .env.example tracked
!.env.example

# ============================================
# Logs
# ============================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ============================================
# Runtime / process files
# ============================================
pids/
*.pid
*.seed
*.pid.lock

# ============================================
# Test / Coverage
# ============================================
coverage/
*.lcov
.nyc_output/
.jest/
test-results/
playwright-report/
playwright/.cache/

# ============================================
# Storage (runtime-generated assets)
# ============================================
# Keep folders, ignore their contents (commit .gitkeep to preserve dirs)
storage/blade/*
!storage/blade/.gitkeep
storage/uploads/*
!storage/uploads/.gitkeep
storage/cache/*
!storage/cache/.gitkeep

# ============================================
# Editor / IDE
# ============================================
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
*.swp
*.swo
*.swn
*~
.project
.settings/
.classpath
.history/

# ============================================
# OS
# ============================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.stackdump

# Linux
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ============================================
# Misc
# ============================================
*.tgz
*.tar.gz
.turbo/
.eslintcache
.stylelintcache
.npm/
.pnpm-store/
