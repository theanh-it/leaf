{
  "name": "leaf",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "NODE_ENV=production bun run dist/server.js",
    "fe": "bun --bun vite --configLoader native",
    "build:fe": "bun --bun vite build --configLoader native",
    "watch": "bun --bun vite build --watch --configLoader native",
    "be": "bunx nodemon --exec \"bun run\" server.ts --ignore \"public/**\" --ignore \"dist/**\"",
    "build:be": "NODE_ENV=production bun build server.ts --outdir dist --target bun",
    "dev": "concurrently \"bun run be\" \"bun run watch\"",
    "build": "bun run build:fe && bun run build:be",
    "prisma:migrate": "bunx --bun prisma migrate dev",
    "prisma:migrate:production": "bunx --bun prisma migrate deploy",
    "prisma:generate": "bunx --bun prisma generate",
    "prisma:seed": "bun run prisma/seed.ts",
    "prisma:reset": "bunx --bun prisma migrate reset",
    "backup": "bun run backup/start.ts",
    "backup:clear": "bun run backup/clear-backup.ts",
    "test": "bun test tests",
    "typecheck": "bunx --bun --no-install vue-tsc --noEmit",
    "test:helpers": "bun test tests/helpers",
    "test:middlewares": "bun test tests/middlewares",
    "test:routes": "bun test tests/routes",
    "test:backup": "bun test tests/backup",
    "test:server": "bun test tests/server.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@elysiajs/cors": "^1.3.3",
    "@elysiajs/static": "1.3.0",
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-regular-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/vue-fontawesome": "^3.2.0",
    "@kyvg/vue3-notification": "^3.4.2",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@vuelidate/core": "^2.0.3",
    "@vuelidate/validators": "^2.0.4",
    "bcrypt": "^6.0.0",
    "cron": "^4.4.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "elysia": "^1.4.16",
    "elysia-nnn-router": "^0.1.7",
    "file-type": "^21.1.1",
    "heic2any": "^0.0.4",
    "jsonwebtoken": "^9.0.3",
    "ky": "^2.0.2",
    "leaf-blade": "^1.2.0",
    "leaf-seo": "^0.1.0",
    "module-alias": "^2.2.3",
    "parse-sse": "^0.1.0",
    "pica": "^9.0.1",
    "pica-resize-image": "^0.0.7",
    "pinia": "^3.0.4",
    "prisma": "^7.8.0",
    "slug": "^11.0.1",
    "tar": "^7.5.22",
    "uid": "^2.0.2",
    "v-wave": "^3.0.4",
    "vue-nnn-router": "^0.0.8",
    "vue-router": "^4.6.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.1",
    "@types/slug": "^5.0.9",
    "@vitejs/plugin-vue": "6.0.10",
    "bun-types": "latest",
    "concurrently": "^8.2.2",
    "html-minifier-terser": "^7.2.0",
    "prettier": "^3.7.4",
    "rollup-plugin-visualizer": "^6.0.5",
    "sass": "^1.94.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "vite": "8.3.4",
    "vue": "^3.5.0",
    "vue-tsc": "^3.3.13"
  }
}
