{
  "name": "leaf",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "bun run dist/server.js",
    "fe": "vite",
    "build:fe": "vite build",
    "watch": "vite build --watch",
    "be": "bunx nodemon --exec \"bun run\" server.ts --ignore public/**",
    "build:be": "bun build server.ts --outdir dist --target bun",
    "dev": "concurrently \"bun run be\" \"bun run watch\"",
    "build": "bun run build:fe; bun run build:be",
    "prisma:migrate": "bunx prisma migrate dev",
    "prisma:migrate:production": "bunx --bun prisma migrate deploy",
    "prisma:generate": "rm -rf node_modules/.prisma/client; bunx prisma generate",
    "prisma:seed": "bun run prisma/seed.ts",
    "prisma:reset": "bunx --bun prisma migrate reset",
    "backup": "bun run backup/start.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@elysiajs/cors": "^1.3.3",
    "@elysiajs/static": "1.3.0",
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-regular-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/vue-fontawesome": "^3.2.0",
    "@kyvg/vue3-notification": "^3.4.2",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@vuelidate/core": "^2.0.3",
    "@vuelidate/validators": "^2.0.4",
    "bcrypt": "^6.0.0",
    "cron": "^4.4.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "elysia": "^1.4.16",
    "elysia-nnn-router": "^0.1.7",
    "heic2any": "^0.0.4",
    "jsonwebtoken": "^9.0.3",
    "ky": "^2.0.2",
    "leaf-blade": "^1.1.0",
    "leaf-seo": "^0.0.1",
    "module-alias": "^2.2.3",
    "parse-sse": "^0.1.0",
    "pica": "^9.0.1",
    "pica-resize-image": "^0.0.7",
